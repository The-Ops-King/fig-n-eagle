# Slack app (from api.slack.com/apps -> your app)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Postgres (Vercel Marketplace -> Neon). Vercel injects this automatically once connected.
DATABASE_URL=postgres://...

# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes.
CRON_SECRET=generate-a-long-random-string

# One GHL Private Integration Token per client. Name must match config/<client>.json -> ghl.tokenEnv
# Scopes needed: calendars.readonly, calendars/events.readonly, calendars/events.write, contacts.readonly, users.readonly
GHL_PIT_FIG_N_EAGLE=pit-...

# Which client config this deployment serves (file name in config/ without .json)
HOT_SWAP_CLIENT=fig-n-eagle
